# Required for production parity mode.
VERXIO_DATABASE_MODE=turso
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Pool Hermes image (hermes-agent/Dockerfile.verxio-hosted).
VERXIO_HERMES_IMAGE=verxio-hermes-runtime:local
HERMES_UID=10000
HERMES_GID=10000

# Persistent host state: control-plane files and local SQLite fallback.
# Local dev: leave unset (uses ./.verxio next to this repo).
# Production: set to an absolute path on persistent disk, e.g. /srv/verxio
# VERXIO_STATE_DIR=/srv/verxio

# Pool plane (docker compose --profile pool). The API does not start per-user
# containers and does not talk to Kubernetes.
# VERXIO_RUNTIME_MANAGER=pool
# VERXIO_INLINE_SCHEDULER=0             # verxio-scheduler owns ticks
# VERXIO_REDIS_URL=redis://redis:6379/0
# VERXIO_RUNTIME_IDLE_ENABLED=true
# VERXIO_RUNTIME_IDLE_POLICY=default    # free|pro|business|always_on
# VERXIO_IDLE_REAPER_ENABLED=true
# VERXIO_IDLE_REAPER_INTERVAL_SECONDS=60
# VERXIO_ARTIFACT_STORE=local           # or s3
# VERXIO_WEBHOOK_INLINE=0               # webhooks are queued to workers
# VERXIO_INTERNAL_TOKEN=                # shared secret for /api/internal/* (shards, workers)
# VERXIO_POOL_DASHBOARD_TOKEN=          # shared Hermes dashboard token on pool workers
# VERXIO_SECRETS_KEY=                   # base64 32 bytes; AES-GCM for channel creds / tenant env
# Tool sandbox. Compose default is the local dind service. Production points
# this at the TLS daemon on the sandbox hosts.
# VERXIO_SANDBOX_DOCKER_HOST=tcp://sandbox.internal:2376
# VERXIO_SANDBOX_DOCKER_TLS_VERIFY=1
# VERXIO_SANDBOX_DOCKER_CERT_PATH=/etc/verxio/sandbox-certs
# VERXIO_SANDBOX_ALLOW_INSECURE=0       # 1 only with the local dind sandbox

# Use true only behind HTTPS.
VERXIO_COOKIE_SECURE=false
VERXIO_CORS_ORIGINS=https://your-verxio-web.example
# Allow Electron desktop (Origin: null) to call the API with session cookies.
# VERXIO_DESKTOP_CORS=false

# Auth code security and email delivery.
# Set VERXIO_AUTH_CODE_SECRET to a long random value in production.
VERXIO_AUTH_CODE_SECRET=change-this-long-random-secret
VERXIO_AUTH_CODE_TTL_MINUTES=10
VERXIO_AUTH_CODE_MAX_ATTEMPTS=5
# Shared beta invite required on signup. Change this to rotate access.
VERXIO_SIGNUP_INVITE_CODE=12345
VERXIO_SMTP_HOST=smtp.example.com
VERXIO_SMTP_PORT=587
VERXIO_SMTP_USERNAME=your-smtp-username
VERXIO_SMTP_PASSWORD=your-smtp-password
VERXIO_SMTP_FROM=Verxio <no-reply@example.com>
VERXIO_SMTP_TLS=true
# Landing (www.verxio.xyz) also uses these SMTP vars to email AIML buyers.
PAYSTACK_SECRET_KEY=

# Verxio Hosted inference (Qwen via DashScope, Gemini via Google AI Studio).
# Injected into runtime containers when users select Verxio Hosted.
# BYOK keys for OpenAI, Anthropic, etc. stay in each Hermes runtime .env.
VERXIO_HOSTED_QWEN_API_KEY=

# Optional operator override for the hosted Qwen model ID (DashScope upstream slug).
# Change this and restart verxio-api to roll out a new default without a code deploy.
VERXIO_HOSTED_QWEN_MODEL=qwen3.6-plus

# Hosted Gemini (Google AI Studio). Uses Hermes native `gemini` provider in runtime config.
VERXIO_HOSTED_GEMINI_API_KEY=

# Optional override for hosted Gemini upstream model (default: gemini-flash-lite-latest).
VERXIO_HOSTED_GEMINI_MODEL=gemini-flash-lite-latest
VERXIO_DEFAULT_MONTHLY_CREDIT_USD=0

# Enables the full Composio toolkits catalog and per-tool previews.
COMPOSIO_API_KEY=your-composio-api-key
COMPOSIO_API_BASE_URL=https://backend.composio.dev/api/v3
COMPOSIO_TOOLS_API_BASE_URL=https://backend.composio.dev/api/v3.1

# Tavus conversational video. The key stays on the API. The desktop only receives call URLs.
TAVUS_API_KEY=
TAVUS_TOOL_SECRET=
# Public https origin Tavus can call for tools and webhooks. Loopback is rejected.
VERXIO_PUBLIC_API_URL=

